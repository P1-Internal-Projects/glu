# --- P1 backend ---
NEXT_PUBLIC_CSS_SITE_ID=site-123
CSS_API_KEY=your-api-key

# Public URL of THIS environment, used to build the post-login redirect.
# Read at runtime (not a NEXT_PUBLIC_ build-time var), so redeploy after setting it.
#
# Set it per environment — each of dev/test/live/multidev needs its own value
# matching its own public URL. A site-level value that every environment inherits
# sends logins to the wrong origin, silently.
#   terminus secret:site:set <site>.live P1_SITE_URL "https://www.yoursite.com" \
#     --type=env --scope=web
#
# Can be left unset once this site's origins are registered in the P1 dashboard:
# the browser then states its origin and the backend verifies it against that
# list, which one wildcard entry covers for every environment. Unset and
# unregistered falls back to the request origin, which is an internal hostname on
# Pantheon — that is the cause of post-login redirects to localhost.
# P1_SITE_URL=https://www.yoursite.com

# --- P1 backend URL (optional) ---
# P1 backend defaults to https://ccr.p1.pantheon.io for production.
# Override for staging, local, or sandbox deployments:
# NEXT_PUBLIC_CSS_BASE_URL=https://staging.ccr.p1.pantheon.io

# --- P1 Admin Dashboard (optional) ---
# Override the default dashboard URL (https://content.pantheon.io)
# NEXT_PUBLIC_P1_ADMIN_DASHBOARD_URL=https://staging.content.pantheon.io

# Branch is auto-detected (defaults to main) unless specified:
# NEXT_PUBLIC_CSS_BRANCH_ID=branch-456

# --- Dev tools (disabled by default) ---
# Show the RoleSwitcher dropdown in the P1 editor for local testing of
# admin/editor/junior-editor permissions. Never enable this in production.
# NEXT_PUBLIC_ENABLE_ROLE_SWITCHER=true

# --- AI chatbot ---
# Both of these are needed. The panel only mounts when the `p1-chatbot`
# LaunchDarkly flag is on for the signed-in user AND an agent URL is set, so
# either one missing means no chatbot and nothing on screen says why.
#
# Both are already set as env-scoped secrets on every Pantheon environment for
# this site (dev, test, live and the multidevs). Copy the same two values here
# if you want the chatbot in local development; without them the editor runs
# fine, just with no panel.
#
# The agent backend that answers the conversation. This is the real value in
# use, not a guess: agent.p1.pantheon.io resolves but is not the chatbot agent.
# NEXT_PUBLIC_AGENT_URL=https://p1-chatbot-agent-production.pantheon-p1-production.workers.dev
#
# LaunchDarkly client-side ID used to evaluate the `p1-chatbot` flag. It is
# public by design (safe to expose in the browser). Note this is Pantheon's
# main environment, not the one hardcoded as a default inside the packages —
# a different ID resolves a different set of flags, and `p1-chatbot` only
# exists in this one. When unset, LaunchDarkly is not initialized at all and
# the flag is simply absent.
# NEXT_PUBLIC_LD_CLIENT_ID=603ff3e677149b0e9043d9a5

# --- Media library (on by default) ---
# Worker API base for the media library and for keeping chat attachments — both
# packages read this one variable, so they cannot point at different environments.
# Unset means different things to each: the library falls back to the production
# worker (https://media.p1.pantheon.io), while chat keeps nothing, so attachments
# do not outlive the tab. Storing someone's files on a host nobody chose is worse
# than not storing them.
# NEXT_PUBLIC_MEDIA_WORKER_URL=http://localhost:8788

# CDN image origin used to validate media URLs — NOT the Worker API URL.
# Defaults to the production origin (https://media.p1.pantheon.io). Override
# for staging, sandbox, or local dev.
# NEXT_PUBLIC_MEDIA_BASE_URL=https://staging.media.p1.pantheon.io

# --- Content Publisher (optional) ---
# Add your secrets to connect to Content Publisher collections and
# automatically pull documents from there into your P1 site.
# PCC_SITE_ID=your-content-publisher-collection-id
# PCC_TOKEN=your-content-publisher-access-token

# --- GLU-specific ---
# Content Publisher backs articles/glu-ai-program and articles/privacy-policy
# (PCCArticleHeader / PCCArticleBody). Set PCC_SITE_ID and PCC_TOKEN above.

# --- Localization ---
# Origin for metadataBase. Required in production: without it Next.js drops the
# relative hreflang alternates the localized pages emit.
# NEXT_PUBLIC_SITE_URL=https://www.grandlakes.edu

# --- Academic program catalog (Drupal) ---
# Origin of the Drupal site serving /glu-program-api. Read server-side only
# during render, so deliberately not NEXT_PUBLIC_: the browser never calls it.
# Unset means the programs listing renders empty rather than failing the page.
GLU_PROGRAM_API_BASE_URL=https://dev-danny-drupal-cms.pantheonsite.io
